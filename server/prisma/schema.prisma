// ============================================================================
// WashFlow - Prisma Schema (MySQL)
// cPanel (CloudLinux + MySQL) uyumlu. Harici Redis/Socket yok.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums ---------------------------------------

enum Role {
  ADMIN
  OPERATOR
}

enum VehicleSegment {
  SEDAN
  SUV
  VAN
}

enum TicketStatus {
  QUEUED // Sirada
  WASHING // Yikamada
  DETAILING // Kurulama / Detay
  READY // Teslime Hazir
  COMPLETED // Teslim Edildi
  CANCELLED // Iptal
}

enum MessageType {
  INTAKE // Arac kabul
  READY // Teslime hazir
  RETENTION // Geri cagirma / hatirlatma
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

// ----------------------------- Models --------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(OPERATOR)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Customer {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(160)
  phone             String   @unique @db.VarChar(20)
  allowMarketingSms Boolean  @default(true) @map("allow_marketing_sms")
  createdAt         DateTime @default(now()) @map("created_at")

  vehicles Vehicle[]

  @@map("customers")
}

model Vehicle {
  id                 Int            @id @default(autoincrement())
  customerId         Int            @map("customer_id")
  plate              String         @unique @db.VarChar(16) // Buyuk harf, bosluksuz formatli
  brandModel         String?        @map("brand_model") @db.VarChar(120)
  segment            VehicleSegment @default(SEDAN)
  lastVisitAt        DateTime?      @map("last_visit_at")
  lastRetentionSmsAt DateTime?      @map("last_retention_sms_at")

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets  JobTicket[]

  @@index([customerId])
  @@index([lastVisitAt])
  @@map("vehicles")
}

model Service {
  id              Int     @id @default(autoincrement())
  name            String  @db.VarChar(120) // Ic-Dis, Detayli, Motor vb.
  category        String  @default("Genel") @db.VarChar(60) // Yikama, Koruma, Ic Temizlik vb.
  price           Decimal @db.Decimal(10, 2)
  durationMinutes Int     @map("duration_minutes")
  active          Boolean @default(true)

  ticketServices JobTicketService[]

  @@index([category])
  @@map("services")
}

model JobTicket {
  id               Int          @id @default(autoincrement())
  ticketCode       String       @unique @map("ticket_code") @db.VarChar(20) // WO-1042
  vehicleId        Int          @map("vehicle_id")
  status           TicketStatus @default(QUEUED)
  totalPrice       Decimal      @default(0) @map("total_price") @db.Decimal(10, 2)
  notes            String?      @db.Text
  trackingToken    String       @unique @map("tracking_token") @db.VarChar(16) // x8k2A
  estimatedReadyAt DateTime?    @map("estimated_ready_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  completedAt      DateTime?    @map("completed_at")

  vehicle  Vehicle            @relation(fields: [vehicleId], references: [id])
  services JobTicketService[]

  @@index([status])
  @@index([vehicleId])
  @@index([createdAt])
  @@map("job_tickets")
}

model JobTicketService {
  id        Int     @id @default(autoincrement())
  ticketId  Int     @map("ticket_id")
  serviceId Int     @map("service_id")
  price     Decimal @db.Decimal(10, 2) // Bilet aninda sabitlenen fiyat (snapshot)

  ticket  JobTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service Service   @relation(fields: [serviceId], references: [id])

  @@unique([ticketId, serviceId])
  @@index([serviceId])
  @@map("job_ticket_services")
}

// WhatsApp (Cloud API) bildirim kuyrugu.
model MessageQueue {
  id           Int           @id @default(autoincrement())
  phone        String        @db.VarChar(20) // WhatsApp hedef no (ör. 905551112233)
  type         MessageType   @map("type")
  // Cloud API template mesaji:
  templateName String?       @map("template_name") @db.VarChar(120)
  languageCode String        @default("tr") @map("language_code") @db.VarChar(10)
  params       Json?         // Template body parametreleri (sirali string dizisi)
  // Loglar/dashboard icin insan-okur onizleme (params ile doldurulmus metin):
  preview      String        @db.Text
  status       MessageStatus @default(PENDING)
  retries      Int           @default(0)
  errorLog     String?       @map("error_log") @db.Text
  scheduledAt  DateTime      @default(now()) @map("scheduled_at")
  sentAt       DateTime?     @map("sent_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([status, scheduledAt])
  @@index([type])
  @@map("message_queue")
}

// Esnek anahtar/deger ayar tablosu.
// Beklenen anahtarlar: intake_wa_enabled, ready_wa_enabled, retention_wa_enabled,
// retention_days_threshold, retention_cooldown_days, wa_lang,
// wa_tpl_intake, wa_tpl_ready, wa_tpl_retention (template ADLARI),
// tpl_intake, tpl_ready, tpl_retention (onizleme metinleri)
model SystemSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("system_settings")
}

// Arac markasi referans/lookup tablosu (Arac Kabul dropdown kaynagi).
model VehicleBrand {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  isPopular Boolean  @default(false) @map("is_popular") // Sik kullanilanlar
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isPopular])
  @@index([active])
  @@map("vehicle_brands")
}
