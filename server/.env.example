# ==========================================================================
# WashFlow - Ortam Degiskenleri (cPanel Node.js App > Environment Variables)
# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
# ==========================================================================

# --- Veritabani (cPanel > MySQL Databases'ten olusturun) ---
# Format: mysql://KULLANICI:SIFRE@HOST:PORT/VERITABANI
DATABASE_URL="mysql://cpaneluser_dbuser:SIFRE@localhost:3306/cpaneluser_washflow"

# --- Sunucu ---
# cPanel Passenger PORT'u kendisi atar; lokal gelistirmede 4000 kullanilir.
PORT=4000
NODE_ENV=production

# Musteriye WhatsApp'ta gidecek takip linkinin kok adresi (sonunda / olmadan)
PUBLIC_BASE_URL="https://oto-yikamam.com"

# Express'in derlenmis React build'ini servis edip etmeyecegi (cPanel tek-app icin true)
SERVE_CLIENT=true

# --- JWT ---
JWT_SECRET="buraya-cok-uzun-rastgele-bir-anahtar-koyun-min-32-karakter"
JWT_EXPIRES_IN="12h"

# --- CORS (frontend ayri domainde servis ediliyorsa virgulle ayirin) ---
# Express client'i kendisi servis ediyorsa bos birakilabilir.
CORS_ORIGINS=""

# ==========================================================================
# WhatsApp (Meta Cloud API)
# ==========================================================================
# WHATSAPP_PROVIDER = "mock"  -> hicbir mesaj gondermez, sadece loglar (gelistirme).
# WHATSAPP_PROVIDER = "cloud" -> gercek Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER="mock"

# Graph API surumu
WHATSAPP_API_VERSION="v21.0"
# Meta Business > WhatsApp > API Setup'tan alinir:
WHATSAPP_PHONE_NUMBER_ID=""
# Kalici (System User) access token onerilir; gecici token 24 saatte expire olur.
WHATSAPP_ACCESS_TOKEN=""
# Varsayilan ulke kodu (TR). 05xx -> 905xx donusumu icin.
WHATSAPP_COUNTRY_CODE="90"

# Cron worker'in tek seferde kuyruktan cekecegi maksimum mesaj sayisi
MESSAGE_BATCH_SIZE=100
# Bir mesaj basarisiz olursa en fazla kac kez yeniden denensin
MESSAGE_MAX_RETRIES=3

# NOT: WhatsApp'ta isletme-baslatan mesajlar icin Meta'da ONAYLI template
# gerekir. Template adlarini ve dilini Ayarlar ekranindan yonetin
# (varsayilan: intake_notification / ready_notification / retention_notification, dil: tr).
# Template body parametre sirasi:
#   INTAKE    -> {{1}}=ad {{2}}=plaka {{3}}=saat {{4}}=takip linki
#   READY     -> {{1}}=ad {{2}}=plaka
#   RETENTION -> {{1}}=plaka
